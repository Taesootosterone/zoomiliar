# Local test defaults. Copy to .env; never commit actual credentials.
HOST=127.0.0.1
PORT=3000
# Required behind an HTTPS reverse proxy; exact public origin without trailing slash.
# PUBLIC_ORIGIN=https://call.example.com
# Configure servers you are authorized to use. [] means local/direct connections only.
ICE_SERVERS_JSON=[]
# Example format only (replace with real operator-provided values):
# ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"temporary-user","credential":"temporary-password"}]
